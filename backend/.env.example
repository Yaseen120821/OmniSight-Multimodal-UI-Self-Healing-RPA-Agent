# -----------------------------------------------------------------------
# OmniSight Backend — Environment Configuration
# Copy to .env and fill in your actual values.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------

# --- Application ---
APP_NAME=OmniSight API
APP_ENV=development
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- PostgreSQL (development) ---
# docker compose service: omnisight_postgres on port 5432
POSTGRES_USER=omnisight
POSTGRES_PASSWORD=omnisight_dev_pass
POSTGRES_DB=omnisight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full async-compatible URL used by SQLAlchemy
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://omnisight:omnisight_dev_pass@localhost:5432/omnisight_db

# --- PostgreSQL (automated tests) ---
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://omnisight:omnisight_dev_pass@localhost:5433/omnisight_test_db

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# --- File Storage ---
# Local base directory for screenshot and report files (Day 3+)
STORAGE_BASE_PATH=./storage
